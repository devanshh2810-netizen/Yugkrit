# Copy this file to .env and fill in real values. Never commit .env to git.

# Flask
FLASK_APP=app.py
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-string

# Database (SQLite by default). To move to PostgreSQL later, set e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/yugkrit
DATABASE_URL=sqlite:///yugkrit.db

# Optional: external AI provider key (not required — a rule-based mock
# AI engine is used automatically if this is not set)
AI_API_KEY=
